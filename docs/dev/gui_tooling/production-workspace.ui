   <string>QWidget {font-family: "Noto Sans CJK TC", "Noto Sans", sans-serif; font-size: 14px; color:#172033; background:#f4f6fa;}
QLabel {background:transparent;} QFrame#header, QFrame#inputPanel, QFrame#helpPanel {background:white; border:1px solid #dce2eb; border-radius:12px;}
QFrame#canvas {background:#e9edf4; border:1px solid #d7dfeb; border-radius:12px;} QFrame#exampleCard {background:white; border:1px solid #c9d2df; border-radius:2px;}
QLineEdit {background:white; border:1px solid #b3bfd0; border-radius:6px; padding:9px; min-height:22px; selection-background-color:#2459c4;}
QLineEdit:focus {border:2px solid #2459c4; padding:8px;}
QPushButton {background:white; border:1px solid #b9c5d5; border-radius:7px; padding:10px 14px; min-height:20px; font-weight:500;}
QPushButton:hover {background:#edf3ff; border-color:#2459c4;} QPushButton:focus {border:2px solid #2459c4; padding:9px 13px;}
QPushButton#primaryAction {background:#2459c4; border-color:#2459c4; color:white; font-weight:600; min-width:130px;}
QPushButton#primaryAction:hover {background:#17459f;} QPushButton:disabled {color:#68758a; background:#edf0f5; border-color:#dce2eb;}
</string>
