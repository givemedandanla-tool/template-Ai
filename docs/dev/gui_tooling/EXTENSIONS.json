  "adoption_decisions": [
    {
      "source": "openai/skills:screenshot",
      "decision": "ADOPTED_AS_PROJECT_ADAPTER",
      "use": "Native development screenshots with explicit owned window ID; original helper and licenses preserved. Qt widget grab remains preferred when sufficient.",
      "limits": "Only Linux/xcb execution verified; macOS and Windows helpers retained as original source, not executed or qualified."
    },
    {
      "source": "anthropics/skills:frontend-design",
      "decision": "ADOPTED_GENERAL_PRINCIPLES_ONLY",
      "use": "Plain user-facing names, purposeful visual hierarchy, plan/review/build/critique, recoverable empty and error states.",
      "limits": "Website hero, brand-font advice, mobile delivery, unfamiliarity questions, and any conflicting visual direction do not override approved desktop requirements."
    },
    {
      "source": "obra/superpowers:requesting-code-review",
      "decision": "ADOPTED_READ_ONLY_REVIEW_TEMPLATE_ONLY",
      "use": "Bounded source/goal/revision context, behavior against requirements, reproducible severity-ranked findings.",
      "limits": "No automatic worktrees, main merge, generic mandatory agent delegation, history dump, or independent certification."
    },
    {
      "source": "pytest-dev/pytest-qt",
      "decision": "RESEARCH_REFERENCE_NO_NEW_DEPENDENCY",
      "use": "Real-widget event and wait concepts; existing unittest/QTest retained.",
      "limits": "No claim pytest-qt was installed or its entire test suite executed."
    }
  ]
